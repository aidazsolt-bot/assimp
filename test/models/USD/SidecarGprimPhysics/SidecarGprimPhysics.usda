#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Z"
    # Pixar usdPhysics examples author this; TinyUSDZ rejects it unless sanitized.
    kilogramsPerUnit = 1.0
)
def Xform "World"
{
    def Cube "BoxActor" (
        prepend apiSchemas = ["Preliminary_PhysicsColliderAPI", "Preliminary_PhysicsRigidBodyAPI"]
    )
    {
        double size = 25
        double3 xformOp:translate = (0, 0, 500)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physics:rigidBodyEnabled = 1
    }
    def Cube "Ground" (
        prepend apiSchemas = ["Preliminary_PhysicsColliderAPI"]
    )
    {
        double size = 2
        float3 xformOp:scale = (750, 750, 10)
        uniform token[] xformOpOrder = ["xformOp:scale"]
        bool physics:collisionEnabled = 1
    }
}
