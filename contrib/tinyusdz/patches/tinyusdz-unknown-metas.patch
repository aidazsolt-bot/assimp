+bool AsciiParser::SkipMetaValueLiteral() {
+  if (!SkipWhitespace()) {
+    return false;
+  }
+  if (Eof()) {
+    return false;
+  }
+
+  char c0 = '\0';
+  if (!Char1(&c0)) {
+    return false;
+  }
+
+  // Dictionary or array: skip balanced braces/brackets (string-aware).
+  if (c0 == '{' || c0 == '[') {
+    const char open = c0;
+    const char close = (c0 == '{') ? '}' : ']';
+    int depth = 1;
+    bool in_string = false;
+    char string_quote = '\0';
+    while (!Eof() && depth > 0) {
+      char c;
+      if (!Char1(&c)) {
+        return false;
+      }
+      if (in_string) {
+        if (c == '\\') {
+          char ignored;
+          if (!Char1(&ignored)) {
+            return false;
+          }
+          continue;
+        }
+        if (c == string_quote) {
+          in_string = false;
+        }
+        continue;
+      }
+      if (c == '"' || c == '\'') {
+        in_string = true;
+        string_quote = c;
+        continue;
+      }
+      if (c == open) {
+        ++depth;
+      } else if (c == close) {
+        --depth;
+      }
+    }
+    return depth == 0;
+  }
+
+  // Unwind first char and consume until end of line (scalar / @asset@ / path).
+  if (!_sr->seek_from_current(-1)) {
+    return false;
+  }
+  std::string ignored;
+  return ReadUntilNewline(&ignored);
+}
